# ---------------------------------------------------------------------------
# ExamPro backend configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/test-platform
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# --- Judge0 (code execution) -----------------------------------------------
# Origin only: no trailing slash, no /api path.
JUDGE0_URL=https://judge.example.com
# Must match the instance's AUTHN_TOKEN. Leave blank if the judge is open.
JUDGE0_AUTH_TOKEN=
# Only change if the instance overrides AUTHN_HEADER.
JUDGE0_AUTH_HEADER=X-Auth-Token

# Per-submission sandbox limits. Judge0 clamps these to its own max_* config,
# so raising them past the instance's limits has no effect.
JUDGE0_CPU_TIME_LIMIT=5          # seconds of CPU per test case
JUDGE0_WALL_TIME_LIMIT=10        # seconds of wall clock per test case
JUDGE0_MEMORY_LIMIT=256000       # KB

# Client behaviour. Defaults suit a ~500 student exam.
JUDGE0_BATCH_SIZE=20             # capped by the judge's max_submission_batch_size
JUDGE0_MAX_CONCURRENT=8          # in-flight HTTP requests to the judge
JUDGE0_REQUEST_TIMEOUT_MS=20000  # per HTTP request
JUDGE0_POLL_TIMEOUT_MS=90000     # total wait for one batch to finish grading
JUDGE0_POLL_INTERVAL_MS=600      # initial poll interval (backs off to 2s)
JUDGE0_MAX_RETRIES=3             # retries on 429 / 5xx / network errors
JUDGE0_FALLBACK_RETRY_MS=60000   # how long to use fallback language IDs before retrying discovery
JUDGE0_RATE_LIMIT_PER_MINUTE=30  # Run+Submit calls allowed per student per minute

# --- Email (password reset, notifications) ---------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Proctoring ------------------------------------------------------------
FACE_RECOGNITION_FALLBACK=false
