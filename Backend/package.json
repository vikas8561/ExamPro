{
  "name": "exampro-backend",
  "version": "1.0.0",
  "description": "ExamPro simple tests API (CommonJS)",
  "main": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=1024 server.js",
    "dev": "nodemon --max-old-space-size=1024 server.js",
    "create-indexes": "node scripts/createIndexes.js",
    "performance-test": "node scripts/performanceMonitor.js",
    "check-judge0": "node scripts/checkJudge0.js",
    "test:security": "node scripts/security/answer-leak-audit.js && node scripts/security/answer-access-regression.js && node scripts/security/submission-ownership-check.js && node scripts/security/paper-before-start-check.js && node scripts/security/results-release-check.js && node scripts/security/hidden-cases-review-check.js && node scripts/security/proctor-gap-check.js",
    "test:seb": "node scripts/security/seb-verification-check.js",
    "test:shuffle": "node scripts/exam/shuffle-order-check.js",
    "test:edit": "node scripts/exam/edit-preserves-answers-check.js",
    "test:exam": "npm run test:shuffle && npm run test:edit && npm run test:autosubmit && npm run test:kinds && npm run test:deep && npm run test:reported && npm run test:output-matching && npm run test:reenable && npm run test:clock && npm run test:blank-coding && npm run test:all-subject && npm run test:mcq-text && npm run test:answer-window && npm run test:late-autosubmit",
    "test:all-subject": "node scripts/exam/all-subject-check.js",
    "test:autosubmit": "node scripts/exam/auto-submit-check.js",
    "test:kinds": "node scripts/exam/submit-all-kinds-check.js",
    "test:deep": "node scripts/exam/deep-audit-check.js",
    "test:reported": "node scripts/exam/reported-issues-check.js",
    "test:output-matching": "node scripts/exam/output-matching-check.js",
    "test:coding-persistence": "node scripts/exam/coding-persistence-check.js",
    "test:mixed": "node scripts/exam/mixed-test-check.js && npm run test:codewindow",
    "test:reenable": "node scripts/exam/re-enable-check.js",
    "audit-coding-marks": "node scripts/auditCodingMarks.js",
    "audit-coding-verdicts": "node scripts/auditCodingVerdicts.js",
    "audit-ungraded-coding": "node scripts/auditUngradedCoding.js",
    "test:db-errors": "node scripts/database-error-check.js",
    "test:lockout": "node scripts/security/lockout-unblock-check.js",
    "test:ownership": "node scripts/security/submission-ownership-check.js",
    "test:clock": "node scripts/exam/timer-clock-check.js",
    "test:paper": "node scripts/security/paper-before-start-check.js",
    "test:codewindow": "node scripts/exam/coding-window-check.js",
    "test:blank-coding": "node scripts/exam/blank-coding-grade-check.js",
    "test:mcq-text": "node scripts/exam/mcq-option-text-check.js",
    "test:answer-window": "node scripts/exam/answer-window-check.js",
    "audit-foreign-submissions": "node scripts/auditForeignSubmissions.js",
    "test:late-autosubmit": "node scripts/exam/late-autosubmit-check.js",
    "test:results-release": "node scripts/security/results-release-check.js",
    "test:hidden-cases": "node scripts/security/hidden-cases-review-check.js",
    "test:proctor-gap": "node scripts/security/proctor-gap-check.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "list": "^2.0.19",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.6",
    "redis": "^5.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
